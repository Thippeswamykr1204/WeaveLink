# Hugging Face Inference (router.huggingface.co, OpenAI-compatible chat API)
# Get a token at https://huggingface.co/settings/tokens (read access is enough)
HF_API_KEY=HF_API_KEY

# Optional — override the default open-source model without touching code
# HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Optional — where the SQLite file lives. Set to /tmp on serverless hosts
# (Vercel etc.) since the rest of the filesystem is read-only at runtime.
# DB_DIR=/tmp
